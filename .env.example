# ============================================================
# EcoSync — Environment Variables
# Copy to .env and fill in your values. Never commit .env!
# ============================================================

# Supabase Project (get from https://supabase.com/dashboard/project/<id>/settings/api)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Config
VITE_APP_NAME=EcoSync
VITE_APP_VERSION=1.0.0

# ============================================================
# Supabase Edge Function Secrets (set via: supabase secrets set)
# These are NEVER exposed to the client.
# ============================================================

# Ed25519 private key in PEM PKCS8 format (server-side only)
# Generate with: openssl genpkey -algorithm Ed25519 -out private.pem
# ECOSYNC_ED25519_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Ed25519 public key as JWK JSON string (safe to cache in IndexedDB)
# Extract with: openssl pkey -in private.pem -pubout | openssl pkey -pubin -outform DER | ...
# ECOSYNC_ED25519_PUBLIC_KEY_JWK='{"kty":"OKP","crv":"Ed25519","x":"..."}'
